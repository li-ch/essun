     8	
     9	RawLogEvent::RawLogEvent(double time, uint32_t type, uint32_t id, uint32_t ev, 
    10	                         double val1, double val2, double val3, string name = "") :
    11	    _time(time), _type(type), _id(id), _ev(ev - 100*type), _val1(val1), _val2(val2), _val3(val3),_name(name)
    12	{
    13	}
    14	
    15	
    16	string RawLogEvent::str() {
    17	    stringstream ss;
    18	    ss << fixed << setprecision(6) << _time;
    19	    ss << " Type=" << _type << " ID=" << _id  << " EV=" << _ev 
    20	       << " VAL1=" << _val1 << " VAL2=" << _val2 << " VAL3=" << _val3;        
    21	    return ss.str();
    22	}
    23	
    24	
    25	Logfile::Logfile(const string& filename, EventList& eventlist) 
    26	: _starttime(0), _eventlist(eventlist), 
    27	  _preamble(ios_base::out | ios_base::in), 
    28	  _logfilename(filename), _numRecords(0)
    29	{
    30	    _logfile = fopen(_logfilename.c_str(), "wbS");
    31	    if (_logfile==NULL) {
    32	        cerr << "Failed to open logfile " << _logfilename << endl;
    33	        exit(1);
    34	    }
    35	}
    36	
    37	Logfile::~Logfile() {
    38	    if (_logfile != NULL) {
    39	        fclose(_logfile);
    40	        transposeLog();
    41	    }
    42	}
    43	
    44	void
    45	Logfile::addLogger(Logger& logger) {
