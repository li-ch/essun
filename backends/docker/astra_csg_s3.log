    60	
    61	void
    62	Logfile::setStartTime(simtime_picosec starttime) {
    63	    _starttime=starttime;
    64	}
    65	
    66	void
    67	Logfile::writeRecord(uint32_t type, uint32_t id, uint32_t ev, 
    68	                     double val1, double val2, double val3) {
    69	    uint64_t time = _eventlist.now();
    70	    if (time<_starttime) return;
    71	    double time_sec = timeAsSec(time);
    72	    fwrite(&time_sec, sizeof(double), 1, _logfile);
    73	    fwrite(&type, sizeof(uint32_t), 1, _logfile);
    74	    fwrite(&id, sizeof(uint32_t), 1, _logfile);
    75	    fwrite(&ev, sizeof(uint32_t), 1, _logfile);
    76	    fwrite(&val1, sizeof(double), 1, _logfile);
    77	    fwrite(&val2, sizeof(double), 1, _logfile);
    78	    fwrite(&val3, sizeof(double), 1, _logfile);
    79	    _numRecords++;
    80	}
    81	
    82	void
    83	Logfile::transposeLog() {
    84	    double* timeRec = new double[_numRecords];
    85	    uint32_t* typeRec = new uint32_t[_numRecords];
    86	    uint32_t* idRec = new uint32_t[_numRecords];
    87	    uint32_t* evRec = new uint32_t[_numRecords];
    88	    double* val1Rec = new double[_numRecords];
    89	    double* val2Rec = new double[_numRecords];
    90	    double *val3Rec = new double[_numRecords];
    91	    FILE* logfile;
    92	    logfile = fopen(_logfilename.c_str(),"rbS");
    93	    if (logfile==NULL) {
    94	        cerr << "Failed to open logfile " << _logfilename << endl;
    95	        exit(1);
    96	    }
    97	    size_t read;
    98	    double rd;
    99	    uint32_t ri;
   100	    int numread;
   101	    for (numread=0; numread<_numRecords; numread++) {
   102	        read = fread(&rd, sizeof(double), 1, logfile); if (read<1) break;
   103	        timeRec[numread] = rd;
   104	        read = fread(&ri, sizeof(uint32_t), 1, logfile); if (read<1) break;
   105	        typeRec[numread] = ri;
   106	        read = fread(&ri, sizeof(uint32_t), 1, logfile); if (read<1) break;
   107	        idRec[numread] = ri;
   108	        read = fread(&ri, sizeof(uint32_t), 1, logfile); if (read<1) break;
   109	        evRec[numread] = ri + 100*typeRec[numread];
   110	        read = fread(&rd, sizeof(double), 1, logfile); if (read<1) break;
   111	        val1Rec[numread] = rd;
   112	        read = fread(&rd, sizeof(double), 1, logfile); if (read<1) break;
   113	        val2Rec[numread] = rd;
   114	        read = fread(&rd, sizeof(double), 1, logfile); if (read<1) break;
   115	        val3Rec[numread] = rd;
   116	    }
   117	    fclose(logfile);
   118	    assert(numread==_numRecords);
   119	    _preamble << "# numrecords=" << numread << endl;
   120	    logfile = fopen(_logfilename.c_str(),"wbS");
   121	    if (logfile==0) {
   122	        cerr << "Failed to open logfile " << _logfilename << endl;
   123	        exit(1);
   124	    }
   125	    while (true) {
   126	        if (_preamble.peek()==-1) break;
   127	        char thisLine[1000];
   128	        _preamble.getline(&thisLine[0],1000);
   129	        fputs(thisLine, logfile);
   130	        fputs("\n", logfile);
   131	    }
   132	    fputs("# transpose=0\n",logfile);
   133	    fputs("# TRACE\n",logfile);
   134	    for (int i=0; i < numread; i++) {
   135	        fwrite(&timeRec[i], sizeof(double), 1, logfile);
   136	        fwrite(&typeRec[i], sizeof(uint32_t), 1, logfile);
   137	        fwrite(&idRec[i],   sizeof(uint32_t), 1, logfile);
   138	        fwrite(&evRec[i],   sizeof(uint32_t), 1, logfile);
   139	        fwrite(&val1Rec[i], sizeof(double), 1, logfile);
   140	        fwrite(&val2Rec[i], sizeof(double), 1, logfile);
   141	        fwrite(&val3Rec[i], sizeof(double), 1, logfile);
   142	    }
   143	    fclose(logfile);
   144	    delete[] timeRec;
   145	    delete[] typeRec;
   146	    delete[] idRec;
   147	    delete[] evRec;
   148	    delete[] val1Rec;
   149	    delete[] val2Rec;
   150	}

