    35	class Logged {
    36	 public:
    37	    typedef uint32_t id_t;
    38	    Logged(const string& name) {_name=name; _log_id=LASTIDNUM; Logged::LASTIDNUM++; _logged_manager.add_logged(this);}
    39	    virtual ~Logged() {}
    40	    virtual void setName(const string& name) { _name=name; }
    41	    virtual const string& str() { return _name; };
    42	    inline id_t get_id() const {return _log_id;}
    43	    // usually things get their own IDs, but flows, for example, get associated with the sender ID
    44	    void set_id(id_t id) {assert(id < LASTIDNUM); _log_id = id;}
    45	    string _name;
    46	    static void dump_idmap() {_logged_manager.dump_idmap();}
    47	 private:
    48	    id_t _log_id;
    49	    static id_t LASTIDNUM;
    50	    static LoggedManager _logged_manager;
    51	};
