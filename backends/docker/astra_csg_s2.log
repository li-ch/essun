# Binary: /opt/astra-sim/build/astra_htsim/build/bin/AstraSim_HTSim  sha256 fe36ee2aae16e7bf43c074f80fa2c7064653b751d9e3178b2075ee0ef5404216
#
# Documented example: upstream examples/run_scripts/htsim/run_htsim.sh at the pin
# (8-NPU all_reduce, 8npus_1MB, Ring_8npus.yml + 8nodes.topo via --htsim_opts -topo).
# The script was NOT executed as-is: it has TWO defects at the pin —
#   (1) EXAMPLE_DIR is required (${EXAMPLE_DIR:?}) but never defined in the script;
#   (2) its TOPO path ${SCRIPT_DIR}/network/htsim/8nodes.topo does not exist
#       (verified in-container: "No such file or directory"); the topo actually
#       ships at examples/network/htsim/8nodes.topo.
# Per the S1 handoff, the binary is invoked directly with absolute paths:
# EXAMPLE_DIR := /opt/astra-sim/examples, TOPO corrected to the real location.
# All flags otherwise mirror the script verbatim, including its `cd` into the
# build dir before running. All input files verified present in-container
# beforehand (8x all_reduce.<0..7>.et, Ring_4chunks.json, no_memory_expansion.json,
# Ring_8npus.yml, 8nodes.topo).

=== EXECUTED COMMAND (host) ===
docker run --name essun-csg-s2 essun/astra-csg-htsim:s1 bash -c '<payload below>'

=== EXECUTED COMMAND (in-container, exact) ===
SECONDS=0
cd /opt/astra-sim/build/astra_htsim/build &&
  /opt/astra-sim/build/astra_htsim/build/bin/AstraSim_HTSim \
    --workload-configuration=/opt/astra-sim/examples/workload/microbenchmarks/all_reduce/8npus_1MB/all_reduce \
    --system-configuration=/opt/astra-sim/examples/system/native_collectives/Ring_4chunks.json \
    --remote-memory-configuration=/opt/astra-sim/examples/remote_memory/analytical/no_memory_expansion.json \
    --network-configuration=/opt/astra-sim/examples/network/analytical/Ring_8npus.yml \
    --htsim_opts -topo /opt/astra-sim/examples/network/htsim/8nodes.topo
rc=$? ; echo ASTRA_EXIT=$rc ; echo ELAPSED_SECONDS=$SECONDS
# (SECONDS/rc echo are S2 logging instrumentation, not part of the tool interface;
#  everything from `cd` through the -topo path is the upstream run_htsim.sh payload,
#  EXAMPLE_DIR/TOPO substituted as above.)

